#!/bin/bash
#PBS -N pinn_depth
#PBS -q workq
#PBS -l select=3:ncpus=2:mem=4gb
#PBS -l place=scatter
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

ROOT="$PBS_O_WORKDIR/runs/pinn/mlp_depth_${PBS_JOBID%%.*}"

mkdir -p "$ROOT"

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Nó 1
pbsdsh -n 0 -- /bin/bash \
    "$PBS_O_WORKDIR/worker_pinn_depth.sh" \
    "$ROOT" 1 4 &
P0=$!

# Nó 2
pbsdsh -n 1 -- /bin/bash \
    "$PBS_O_WORKDIR/worker_pinn_depth.sh" \
    "$ROOT" 2 3 &
P1=$!

# Nó 3
pbsdsh -n 2 -- /bin/bash \
    "$PBS_O_WORKDIR/worker_pinn_depth.sh" \
    "$ROOT" 5 &
P2=$!

STATUS=0

wait "$P0" || STATUS=1
wait "$P1" || STATUS=1
wait "$P2" || STATUS=1

COUNT=$(find "$ROOT/results/burgers" \
    -name metrics.json 2>/dev/null | wc -l)

echo "Treinamentos finalizados: $COUNT/50"

if [ "$COUNT" -ne 50 ]; then
    STATUS=1
fi

echo "Status final: $STATUS"
exit "$STATUS"
