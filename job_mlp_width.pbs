#!/bin/bash
#PBS -N mlp_width
#PBS -q workq
#PBS -l select=3:ncpus=2:mem=4gb
#PBS -l place=scatter
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

PYTHON="$HOME/miniforge3/envs/mpc/bin/python"
ROOT="$PBS_O_WORKDIR/runs/mlp_width_${PBS_JOBID%%.*}"

mkdir -p "$ROOT"

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Gerar configuracoes
"$PYTHON" - "$ROOT" <<'PY'
import sys
import copy
import yaml
from pathlib import Path

root = Path(sys.argv[1])
original = yaml.safe_load(Path("config.yaml").read_text())

experimentos = [
    (3, 16),
    (3, 64),
    (3, 128),
    (5, 16),
    (5, 64),
    (5, 128),
]

for depth, width in experimentos:
    name = f"mlp_d{depth}_w{width}"
    cfg = copy.deepcopy(original)

    cfg["models"] = [{
        "name": name,
        "kind": "mlp",
        "width": width,
        "depth": depth,
        "activation": "tanh"
    }]

    cfg["training"] = {
        "device": "cpu",
        "epochs": 5000,
        "batch_size": 300,
        "lr": 0.001,
        "scheduler": "none",
        "clip": None
    }

    cfg["data"] = {
        "train": 300,
        "val": 300,
        "test_grid": 250
    }

    cfg["seeds"] = [
        1924, 1925, 1926, 1973, 2025,
        2024, 2012, 1958, 1962, 1997
    ]

    cfg["output"] = str(root / "results" / name)
    cfg["ablations"] = []

    (root / f"config_{name}.yaml").write_text(
        yaml.safe_dump(cfg, sort_keys=False)
    )
PY

echo "Job: $PBS_JOBID"
echo "Nos:"
sort -u "$PBS_NODEFILE"

# Dois experimentos sequenciais por no
pbsdsh -n 0 -- /bin/bash "$PBS_O_WORKDIR/mlp_width_worker.sh" \
    "$ROOT" mlp_d3_w16 mlp_d3_w64 &
P1=$!

pbsdsh -n 1 -- /bin/bash "$PBS_O_WORKDIR/mlp_width_worker.sh" \
    "$ROOT" mlp_d3_w128 mlp_d5_w16 &
P2=$!

pbsdsh -n 2 -- /bin/bash "$PBS_O_WORKDIR/mlp_width_worker.sh" \
    "$ROOT" mlp_d5_w64 mlp_d5_w128 &
P3=$!

STATUS=0
wait "$P1" || STATUS=1
wait "$P2" || STATUS=1
wait "$P3" || STATUS=1

echo "Status final: $STATUS"
exit "$STATUS"
