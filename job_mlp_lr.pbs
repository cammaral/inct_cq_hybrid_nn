#!/bin/bash
#PBS -N mlp_lr
#PBS -q workq
#PBS -l select=4:ncpus=2:mem=4gb
#PBS -l place=scatter
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

PYTHON="$HOME/miniforge3/envs/mpc/bin/python"
ROOT="$PBS_O_WORKDIR/runs/mlp_lr_${PBS_JOBID%%.*}"

mkdir -p "$ROOT"

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Gerar configuracoes
"$PYTHON" - "$ROOT" <<'PY'
import sys
import copy
import yaml
from pathlib import Path

root = Path(sys.argv[1])
original = yaml.safe_load(Path("config.yaml").read_text())

learning_rates = [0.0001, 0.0005, 0.005, 0.01]

for lr in learning_rates:
    name = f"mlp_lr_{str(lr).replace('.', 'p')}"
    cfg = copy.deepcopy(original)

    cfg["models"] = [{
        "name": name,
        "kind": "mlp",
        "width": 32,
        "depth": 3,
        "activation": "tanh"
    }]

    cfg["training"] = {
        "device": "cpu",
        "epochs": 15000,
        "batch_size": 300,
        "lr": lr,
        "scheduler": "none",
        "clip": None
    }

    cfg["data"] = {
        "train": 300,
        "val": 300,
        "test_grid": 250
    }

    cfg["seeds"] = [
        1924, 1925, 1926, 1973, 2025,
        2024, 2012, 1958, 1962, 1997
    ]

    cfg["output"] = str(root / "results")
    cfg["ablations"] = []

    (root / f"config_{name}.yaml").write_text(
        yaml.safe_dump(cfg, sort_keys=False)
    )
PY

echo "Job: $PBS_JOBID"
sort -u "$PBS_NODEFILE"

pbsdsh -n 0 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_mlp_lr_0p0001.yaml" \
    --problem burgers > "$ROOT/lr_0p0001.log" 2>&1 &
P1=$!

pbsdsh -n 1 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_mlp_lr_0p0005.yaml" \
    --problem burgers > "$ROOT/lr_0p0005.log" 2>&1 &
P2=$!

pbsdsh -n 2 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_mlp_lr_0p005.yaml" \
    --problem burgers > "$ROOT/lr_0p005.log" 2>&1 &
P3=$!

pbsdsh -n 3 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_mlp_lr_0p01.yaml" \
    --problem burgers > "$ROOT/lr_0p01.log" 2>&1 &
P4=$!

STATUS=0
wait "$P1" || STATUS=1
wait "$P2" || STATUS=1
wait "$P3" || STATUS=1
wait "$P4" || STATUS=1

echo "Status final: $STATUS"
exit "$STATUS"
