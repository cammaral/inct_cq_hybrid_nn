#!/bin/bash
#PBS -N mlp_depth
#PBS -q workq
#PBS -l select=3:ncpus=2:mem=4gb
#PBS -l place=scatter
#PBS -l walltime=48:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

PYTHON="$HOME/miniforge3/envs/mpc/bin/python"
ROOT="$PBS_O_WORKDIR/runs/mlp_depth_${PBS_JOBID%%.*}"

mkdir -p "$ROOT"

export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

# Criar tres configuracoes a partir do YAML existente
"$PYTHON" - "$ROOT" <<'PY'
import sys
import yaml
from pathlib import Path

root = Path(sys.argv[1])
original = yaml.safe_load(Path("config.yaml").read_text())

for depth in (1, 3, 5):
    cfg = original.copy()
    cfg["models"] = [{
        "name": f"mlp_depth_{depth}",
        "kind": "mlp",
        "width": 32,
        "depth": depth,
        "activation": "tanh",
    }]

    cfg["training"] = {
        "device": "cpu",
        "epochs": 5000,
        "batch_size": 300,
        "lr": 0.001,
        "scheduler": "none",
        "clip": None,
    }

    cfg["data"] = {
        "train": 300,
        "val": 300,
        "test_grid": 250,
    }

    cfg["seeds"] = [
        1924, 1925, 1926, 1973, 2025,
        2024, 2012, 1958, 1962, 1997
    ]

    cfg["output"] = str(root / "results")
    cfg["ablations"] = []

    (root / f"config_depth_{depth}.yaml").write_text(
        yaml.safe_dump(cfg, sort_keys=False)
    )
PY

echo "Job: $PBS_JOBID"
echo "Nos alocados:"
sort -u "$PBS_NODEFILE"

# Executar cada profundidade em um no diferente
pbsdsh -n 0 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_depth_1.yaml" \
    --problem burgers > "$ROOT/depth_1.log" 2>&1 &
P1=$!

pbsdsh -n 1 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_depth_3.yaml" \
    --problem burgers > "$ROOT/depth_3.log" 2>&1 &
P2=$!

pbsdsh -n 2 -- "$PYTHON" -u "$PBS_O_WORKDIR/run.py" \
    --config "$ROOT/config_depth_5.yaml" \
    --problem burgers > "$ROOT/depth_5.log" 2>&1 &
P3=$!

STATUS=0
wait "$P1" || STATUS=1
wait "$P2" || STATUS=1
wait "$P3" || STATUS=1

echo "Finalizado com status: $STATUS"
exit "$STATUS"
